# ==============================================================================
# Wind Generation Forecast Monitor - Environment Configuration
# ==============================================================================

# Application environment: development | production | test
APP_ENV=development

# Server port (used locally and on container hosts)
PORT=8000

# SQLite database file URL (relative to backend directory or absolute)
DATABASE_URL=sqlite:///./data/app.db

# Elexon BMRS API base URL
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Target Decision Month Boundaries (inclusive ISO dates)
DECISION_MONTH_START=2026-01-01
DECISION_MONTH_END=2026-01-31

# Default day-ahead decision cut-off time (HH:MM in Europe/London time on D-1)
DEFAULT_CUTOFF=09:00

# Market time zone
TIMEZONE=Europe/London

# Ingestion batch window in days (respects Elexon query size limits)
CHUNK_DAYS=3

# HTTP Client resilience settings
HTTP_TIMEOUT_S=20
HTTP_MAX_RETRIES=5

# Admin API Key for triggering protected endpoints (leave blank to disable in dev)
ADMIN_API_KEY=

# CORS allowed origins (comma-separated; leave empty for same-origin)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (slowapi format)
RATE_LIMIT=120/minute

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
